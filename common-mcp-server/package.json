{
  "name": "common-mcp-server",
  "version": "1.0.0",
  "description": "Hybrid-authenticated MCP server for Figma, Jira, Confluence, SharePoint, and Backstage",
  "type": "module",
  "main": "dist/remote-server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/remote-server.js",
    "dev:remote": "tsc && node dist/remote-server.js",
    "start": "node dist/remote-server.js",
    "start:remote": "node dist/remote-server.js",
    "watch": "tsc --watch",
    "test": "node --test",
    "confluence:search-pages": "node confluence/search-pages.mjs",
    "confluence:get-page": "node confluence/get-page.mjs",
    "confluence:create-page": "node confluence/create-page.mjs",
    "confluence:update-page": "node confluence/update-page.mjs",
    "map-tokens": "node figma/map-tokens-to-angular.mjs",
    "test:figma-tokens": "node figma/test-token-mapper.mjs",
    "jira:get-issues": "node jira/get-issues.mjs",
    "jira:get-issue": "node jira/get-issue.mjs",
    "jira:create-issue": "node jira/create-issue.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "jose": "^6.2.8",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

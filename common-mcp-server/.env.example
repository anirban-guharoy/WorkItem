# Server-side Figma service-account token. Store in a secret manager; do not put in IDE config.
FIGMA_API_TOKEN=your_token_here

# Figma file key to target the specific file in Figma
FIGMA_FILE_KEY=your_figma_file_key_here

# Angular component name used by figma/map-tokens-to-angular.mjs
COMPONENT_NAME=YourComponentName

# Server-side Jira service-account credentials. Store secrets outside IDE config.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=mcp-service-account@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here

# Optional helper-script defaults for jira/*.mjs
JIRA_PROJECT_KEY=YOURPROJECT
JIRA_ISSUE_KEY=YOURPROJECT-123

# Server-side Confluence service-account credentials. Store secrets outside IDE config.
# Use either your site URL or the /wiki base; the client normalizes both.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=mcp-service-account@yourcompany.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Optional helper defaults for Confluence tools
CONFLUENCE_SPACE_KEY=TEAM
CONFLUENCE_PARENT_PAGE_ID=123456
CONFLUENCE_PAGE_ID=123456

# Server-side Xray Cloud API key credentials (Xray > Settings > API Keys). Store secrets outside IDE config.
# XRAY_BASE_URL is optional; use https://us.xray.cloud.getxray.app, https://eu..., or https://au... for regional hosts.
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret
XRAY_BASE_URL=https://xray.cloud.getxray.app

# Remote IDE users authenticate individually with Entra ID. The remote server validates
# each bearer token for this tenant, API audience and delegated scope.
ENTRA_AUTH_ENABLED=true
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-mcp-api-app-id
ENTRA_APP_ID_URI=api://your-mcp-api-app-id
ENTRA_API_SCOPE=access_as_user
# Optional, comma-separated allow-list of user emails/UPNs.
ENTRA_ALLOWED_USER_EMAILS=

# Remote MCP over Streamable HTTP (run with npm start)
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_HOST=0.0.0.0
MCP_PORT=3000
# Optional comma-separated host and browser-origin allow-lists
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://your-ide-web-client.example.com

# SharePoint uses the authenticated user's Entra identity with the server app's OBO credential.
# Grant delegated Microsoft Graph Files.Read.All to this API app and keep this secret server-side.
ENTRA_CLIENT_SECRET=

# Remote Backstage catalog API. The MCP host obtains an app-only Entra token using
# DefaultAzureCredential (managed identity in Azure; standard Azure credentials locally).
# Grant the MCP identity application access to the Backstage API.
BACKSTAGE_BASE_URL=https://backstage.example.com
BACKSTAGE_API_SCOPE=api://your-backstage-app-id/.default

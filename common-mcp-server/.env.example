# Figma API token for authentication
# Get this from your Figma account settings: https://www.figma.com/developers/api#access-tokens
FIGMA_API_TOKEN=your_token_here

# Figma file key to target the specific file in Figma
FIGMA_FILE_KEY=your_figma_file_key_here

# Angular component name used by figma/generate-component.mjs and figma/map-tokens-to-angular.mjs
COMPONENT_NAME=YourComponentName

# Main frame / node ID used by figma/update-component-from-figma.mjs
FIGMA_MAIN_FRAME_ID=your_main_frame_id_here

# Jira integration settings
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Optional helper-script defaults for jira/*.mjs
JIRA_PROJECT_KEY=YOURPROJECT
JIRA_ISSUE_KEY=YOURPROJECT-123

# Confluence integration settings
# Use either your site URL or the /wiki base; the client normalizes both.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Optional helper defaults for Confluence tools
CONFLUENCE_SPACE_KEY=TEAM
CONFLUENCE_PARENT_PAGE_ID=123456
CONFLUENCE_PAGE_ID=123456

# MongoDB vector database settings
# MONGODB_VECTOR_INDEX must match a vector search index configured on the collection.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=common_mcp
MONGODB_COLLECTION=vectors
MONGODB_VECTOR_INDEX=vector_index

# Optional MongoDB vector field overrides
MONGODB_EMBEDDING_FIELD=embedding
MONGODB_CONTENT_FIELD=content

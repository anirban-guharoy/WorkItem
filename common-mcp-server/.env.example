# Figma API token for authentication
# Get this from your Figma account settings: https://www.figma.com/developers/api#access-tokens
FIGMA_API_TOKEN=your_token_here

# Figma file key to target the specific file in Figma
FIGMA_FILE_KEY=your_figma_file_key_here

# Angular component name used by figma/generate-component.mjs and figma/map-tokens-to-angular.mjs
COMPONENT_NAME=YourComponentName

# Main frame / node ID used by figma/update-component-from-figma.mjs
FIGMA_MAIN_FRAME_ID=your_main_frame_id_here

# Jira integration settings
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Optional helper-script defaults for jira/*.mjs
JIRA_PROJECT_KEY=YOURPROJECT
JIRA_ISSUE_KEY=YOURPROJECT-123

# Confluence integration settings
# Use either your site URL or the /wiki base; the client normalizes both.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Optional helper defaults for Confluence tools
CONFLUENCE_SPACE_KEY=TEAM
CONFLUENCE_PARENT_PAGE_ID=123456
CONFLUENCE_PAGE_ID=123456

# MongoDB vector database settings
# MONGODB_VECTOR_INDEX must match a vector search index configured on the collection.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=common_mcp
MONGODB_COLLECTION=vectors
MONGODB_VECTOR_INDEX=vector_index

# Optional MongoDB vector field overrides
MONGODB_EMBEDDING_FIELD=embedding
MONGODB_CONTENT_FIELD=content

# Azure Entra ID developer authentication for MCP access
# Set ENTRA_AUTH_ENABLED=true to require a native Entra token or fallback device-code sign-in.
ENTRA_AUTH_ENABLED=false
# Preferred: provide a native Entra JWT from the host environment.
ENTRA_ACCESS_TOKEN=
# Optional alternate token env names checked if ENTRA_ACCESS_TOKEN is unset.
AZURE_ACCESS_TOKEN=
ENTRA_ID_TOKEN=
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-public-client-app-id
# Optional, comma-separated scopes. Default: https://graph.microsoft.com/User.Read
ENTRA_SCOPES=https://graph.microsoft.com/User.Read
# Optional, comma-separated allow-list of user emails/UPNs.
ENTRA_ALLOWED_USER_EMAILS=developer@yourcompany.com
# Optional, comma-separated allow-list of token audiences.
ENTRA_ALLOWED_TOKEN_AUDIENCES=api://your-app-id,00000003-0000-0000-c000-000000000000

# Remote MCP over Streamable HTTP (run with npm run start:remote)
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_HOST=0.0.0.0
MCP_PORT=3000
# Optional comma-separated host and browser-origin allow-lists
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://your-ide-web-client.example.com
ENTRA_APP_ID_URI=api://your-app-id
ENTRA_API_SCOPE=access_as_user

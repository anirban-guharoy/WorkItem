{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Common MCP Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.js",
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "FIGMA_API_TOKEN": "${env:FIGMA_API_TOKEN}"
      }
    }
  ]
}

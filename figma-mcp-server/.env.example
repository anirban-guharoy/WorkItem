# Figma API token for authentication
# Get this from your Figma account settings: https://www.figma.com/developers/api#access-tokens
FIGMA_API_TOKEN=your_token_here

# Figma file key to target the specific file in Figma
FIGMA_FILE_KEY=your_figma_file_key_here

# Angular component name used by generate-component.mjs and map-tokens-to-angular.mjs
COMPONENT_NAME=YourComponentName

# Main frame / node ID used by update-component-from-figma.mjs
FIGMA_MAIN_FRAME_ID=your_main_frame_id_here
